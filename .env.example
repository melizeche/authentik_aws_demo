# Copiá este archivo a .env y completá los valores.
# Los scripts lo cargan solos. Una variable que pases en la línea de comandos
# tiene prioridad (por eso la sintaxis ${VAR:-valor}).
# No subas el .env a Git: contiene el client secret.

# --- AWS ---
REGION=${REGION:-us-east-1}

# --- Stack de authentik (authentik-demo.yaml) ---
AK_STACK=${AK_STACK:-demo-authentik}
AK_TEMPLATE=${AK_TEMPLATE:-authentik-demo.yaml}
# Certificado de ACM en la misma región, en estado Issued, que cubra los dos hosts
CERT_ARN=${CERT_ARN:-arn:aws:acm:us-east-1:123456789012:certificate/REEMPLAZAR}
AUTHENTIK_VERSION=${AUTHENTIK_VERSION:-2026.8.4}
DB_VERSION=${DB_VERSION:-17}
DB_INSTANCE_TYPE=${DB_INSTANCE_TYPE:-t4g.small}
AUTHENTIK_HOST=${AUTHENTIK_HOST:-auth.example.com}

# --- Stack de whoami (whoami-demo.yaml) ---
APP_STACK=${APP_STACK:-demo-authentik-whoami}
APP_HOST=${APP_HOST:-app.example.com}
AUTHENTIK_APP_SLUG=${AUTHENTIK_APP_SLUG:-whoami}
IMAGE=${IMAGE:-python:3.13-slim}

# Provider OAuth2/OpenID de la aplicación whoami en authentik
CLIENT_ID=${CLIENT_ID:-REEMPLAZAR}
# El Client Secret completo, sin espacios ni saltos de línea
CLIENT_SECRET=${CLIENT_SECRET:-REEMPLAZAR}
